# Docker Compose / local environment template
# Copy to .env before running docker compose up

POSTGRES_HOST_PORT=5433
VALKEY_HOST_PORT=6390
KEYCLOAK_HOST_PORT=8180
GUARDRAILS_HOST_PORT=9100
INFISICAL_HOST_PORT=8081
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=5173

# App runtime
LOG_LEVEL=DEBUG
API_KEY_SECRET_PEPPER=B4DVIiR-4ryKG4KFhk2nXirPFKDdismX0nZ1SiWlloE
AWS_REGION_NAME=us-east-1

# Identity Provider
# Set to None to disable the global identity provider for this deployment.
IDENTITY_PROVIDER=None
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/gateway/protocol/openid-connect/certs
KEYCLOAK_REALM=gateway
KEYCLOAK_CLIENT_ID=gateway-frontend
KEYCLOAK_AUDIENCE=gateway-backend

# Secret Provider (Infisical self-hosted)
# Set to None to disable the provider backend entirely for this deployment.
SECRET_PROVIDER=None
INFISICAL_SITE_URL=http://localhost:8081
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev

# Infisical container secrets (must match the image's env names)
ENCRYPTION_KEY=dev-encryption-key-change-me
AUTH_SECRET=dev-auth-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me

# Optional provider secret backend settings
AWS_SECRETS_REGION=
AWS_SECRET_NAME_PREFIX=llm-gateway
GCP_PROJECT_ID=
AZURE_KEYVAULT_NAME=
VAULT_ADDR=
VAULT_TOKEN=
