# App
APP_NAME=llm-gateway
ENVIRONMENT=local
LOG_LEVEL=DEBUG

# Optional other secret backends
AWS_SECRETS_REGION=
AWS_SECRET_NAME_PREFIX=llm-gateway
GCP_PROJECT_ID=
AZURE_KEYVAULT_NAME=
VAULT_ADDR=
VAULT_TOKEN=

# Postgres
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
database_schema=ai_gateway

# Valkey
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_USER=
VALKEY_PASSWORD=
# Legacy URL form: if set, it takes precedence over the explicit host/user/password/db values.
VALKEY_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60

# Identity provider
# Set to None to disable the global identity provider for this deployment.
IDENTITY_PROVIDER=None
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=tcsaigateway
KEYCLOAK_CLIENT_ID=tcsaigateway-frontend
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/tcsaigateway/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=tcsaigateway-backend

# Guardrails
GUARDRAILS_BASE_URL=http://localhost:9000
GUARDRAILS_TIMEOUT_SECONDS=5.0

# Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
# GOOGLE_API_KEY
# AZURE_OPENAI_KEY

# Security
API_KEY_PREFIX=gw
API_KEY_SECRET_PEPPER=zo7ftqGD90k7hK3VzpkFy6CjiQ7vmDnMjl0B8YW3tEU

# Secret provider
# Set to None to disable the provider backend entirely for this deployment.
SECRET_PROVIDER=None
INFISICAL_SITE_URL=http://localhost:8081
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev

# MCP Gateway
MCP_PROTOCOL_VERSION=2025-06-18
MCP_CLIENT_TIMEOUT_SECONDS=10.0
MCP_DISCOVERY_REFRESH_SECONDS=300
MCP_DEFAULT_RATE_LIMIT_PER_WINDOW=60
