{
  "realm": "tcsaigateway",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full administrative access" },
      { "name": "team_lead", "description": "Manages budgets and projects for their organization" },
      { "name": "developer", "description": "Can create API keys scoped to their own project" },
      { "name": "viewer", "description": "Read-only access" }
    ]
  },
  "clients": [
    {
      "clientId": "tcsaigateway-frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tcsaigateway-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "tcsaigateway-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tcsaigateway-backend",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin@tcsaigateway.local",
      "email": "admin@tcsaigateway.local",
      "firstName": "Tcsaigateway",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "team_lead@tcsaigateway.local",
      "email": "team_lead@tcsaigateway.local",
      "firstName": "Tcsaigateway",
      "lastName": "Team Lead",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "team_lead123", "temporary": false }
      ],
      "realmRoles": ["team_lead"]
    },
    {
      "username": "developer@tcsaigateway.local",
      "email": "developer@tcsaigateway.local",
      "firstName": "Tcsaigateway",
      "lastName": "Developer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "developer123", "temporary": false }
      ],
      "realmRoles": ["developer"]
    },
    {
      "username": "viewer@tcsaigateway.local",
      "email": "viewer@tcsaigateway.local",
      "firstName": "Tcsaigateway",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "viewer123", "temporary": false }
      ],
      "realmRoles": ["viewer"]
    }
  ]
}
