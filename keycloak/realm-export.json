{
  "realm": "tcsaigateway",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,

  "defaultSignatureAlgorithm": "RS256",

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,

  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "bruteForceProtected": true,

  "passwordPolicy": "length(14) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1) and notUsername and passwordHistory(5)",

  "roles": {
    "realm": [
      { "name": "admin", "description": "Full administrative access" },
      { "name": "team_lead", "description": "Manages budgets and projects for their organization" },
      { "name": "developer", "description": "Can create API keys scoped to their own project" },
      { "name": "viewer", "description": "Read-only access" }
    ]
  },

  "groups": [
    {
      "name": "default-viewer",
      "path": "/default-viewer",
      "realmRoles": [
        "viewer"
      ]
    }
  ],

  "defaultGroups": [
    "/default-viewer"
  ],

  "clients": [
    {
      "clientId": "tcsaigateway-frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tcsaigateway-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "tcsaigateway-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },

    {
      "clientId": "tcsaigateway-backend",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],

  "users": [
    {
      "username": "admin@tcsaigateway.local",
      "email": "admin@tcsaigateway.local",
      "firstName": "Tcsaigateway",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "Admin@2026!Gateway", "temporary": true }
      ],
      "realmRoles": ["admin"]
    },

    {
      "username": "team_lead@tcsaigateway.local",
      "email": "team_lead@tcsaigateway.local",
      "firstName": "Tcsaigateway",
      "lastName": "Team Lead",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "Teamlead@2026!Gateway", "temporary": true }
      ],
      "realmRoles": ["team_lead"]
    },

    {
      "username": "developer@tcsaigateway.local",
      "email": "developer@tcsaigateway.local",
      "firstName": "Tcsaigateway",
      "lastName": "Developer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "Developer@2026!Gateway", "temporary": true }
      ],
      "realmRoles": ["developer"]
    },

    {
      "username": "viewer@tcsaigateway.local",
      "email": "viewer@tcsaigateway.local",
      "firstName": "Tcsaigateway",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "Viewer@2026!Gateway", "temporary": true }
      ],
      "realmRoles": ["viewer"]
    }
  ]
}
